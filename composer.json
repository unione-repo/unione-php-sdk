{
    "name": "unione-repo/unione-php-sdk",
    "version": "2.3.0",
    "description": "UniOne Web API client library for PHP",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "unione",
        "email",
        "api",
        "sdk"
    ],
    "homepage": "https://github.com/unione-repo/unione-php-sdk",
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "suggest": {
        "psr/http-client": "To send the requests with a PSR-18 client (Guzzle, ...) through Psr18Transport"
    },
    "autoload": {
        "psr-4": {
            "UniOne\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "2.x-dev"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5|^11.0"
    },
    "autoload-dev": {
        "psr-4": {
            "UniOne\\Tests\\": "tests/"
        }
    }
}
